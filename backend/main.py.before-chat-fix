@app.post("/quiz")
def generate_quiz(request: QuizRequest):
    api_key = os.getenv("GEMINI_API_KEY")

    if not api_key:
        raise HTTPException(
            status_code=500,
            detail="GEMINI_API_KEY is not configured.",
        )

    pdf_path: Path | None = None

    if request.material_id:
        candidate = (
            UPLOAD_DIR /
            f"{request.material_id}.pdf"
        )

        if not candidate.is_file():
            raise HTTPException(
                status_code=404,
                detail="Learning material not found.",
            )

        pdf_path = candidate

    prompt = f"""
Create a {request.count}-question multiple-choice quiz.

Topic:
{request.topic}

If learning material is attached, use it as the primary source.

Return ONLY JSON using this structure:

{{
  "title": "Quiz title",
  "questions": [
    {{
      "question": "Question text",
      "options": ["A", "B", "C", "D"],
      "answer": 0,
      "explanation": "Short explanation"
    }}
  ]
}}

Rules:
- answer must be a zero-based option index.
- Questions should test understanding.
- Keep options plausible.
- Never invent document facts.
"""

    client = genai.Client(api_key=api_key)

    uploaded_file = None

    if pdf_path is not None:
        uploaded_file = client.files.upload(
            file=pdf_path
        )

    result, model_used = generate_json(
        client=client,
        prompt=prompt,
        uploaded_file=uploaded_file,
    )

    result["model_used"] = model_used

    return result


