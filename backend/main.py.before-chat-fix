# ============================================================
# CONFIG
# ============================================================

def get_models() -> list[str]:
    primary = os.getenv("GEMINI_MODEL", "").strip()

    fallback_text = os.getenv(
        "GEMINI_FALLBACK_MODELS",
        "",
    )

    models: list[str] = []

    if primary:
        models.append(primary)

    for model in fallback_text.split(","):
        model = model.strip()

        if model and model not in models:
            models.append(model)

    if not models:
        raise RuntimeError(
            "GEMINI_MODEL is missing from backend/.env"
        )

    return models


def is_retryable_error(error: Exception) -> bool:
    message = str(error).lower()

    keywords = (
        "503",
        "429",
        "unavailable",
        "high demand",
        "overloaded",
        "resource exhausted",
        "too many requests",
        "timeout",
        "temporarily",
    )

    return any(word in message for word in keywords)


# ============================================================
# INTENT / WEB
# ============================================================

def needs_web(question: str) -> bool:
    text = question.lower()

    triggers = (
        "latest",
        "current",
        "today",
        "recent",
        "news",
        "now",
        "2026",
        "price",
        "stock",
        "weather",
        "score",
        "match",
        "result",
        "announcement",
        "update",
        "what happened",
    )

    return any(trigger in text for trigger in triggers)


# ============================================================
# PROMPT
# ============================================================

def build_prompt(
    question: str,
    mode: str,
    has_material: bool,
    web_enabled: bool,
) -> str:

    if has_material:
        material_rule = """
The student supplied learning material.
Use that material as the primary source for questions about it.
Do not invent facts that contradict the material.
If the material does not contain enough information, clearly say so.
"""
    else:
        material_rule = """
No personal learning material was supplied.
Answer using your general knowledge.
Do not pretend that a personal PDF was provided.
"""

    if web_enabled:
        web_rule = """
This question may require current information.
Use web research when appropriate.
Prefer reliable sources.
Separate current facts from general knowledge.
"""
    else:
        web_rule = """
Do not use web research unless it is necessary.
"""

    mode_rule = {
        "learn": """
Teach naturally.
Start with the direct answer.
Use numbered steps for difficult concepts.
Use examples when helpful.
End with a short takeaway or practice question when useful.
Do not force unnecessary sections.
""",
        "exam": """
Prepare the student for an exam.
Give the definition, explanation, important points,
example, and concise exam-ready answer when appropriate.
""",
        "notes": """
Create clean revision notes with headings,
definitions, key points, examples, and quick revision.
""",
        "quick": """
Give a concise and direct answer.
Avoid unnecessary detail.
""",
    }.get(mode, """
Teach naturally and clearly.
""")

    return f"""
You are EduVerse OS, a universal AI Learning Brain.

You help students with:
Java, Python, C++, JavaScript, TypeScript, SQL,
DBMS, AI, mathematics, physics, chemistry,
data structures, electronics, exams, notes, and general learning.

CORE RULES:
1. Answer the student's actual question first.
2. Match the student's language or language-mix when practical.
3. Preserve technical words and code syntax.
4. Give correct programming examples when useful.
5. For mathematics, use LaTeX such as $x^2$ or $$x^2+y^2=z^2$$.
6. Never invent facts from supplied material.
7. Never claim web research was used when it was not.
8. Use clean Markdown.
9. Be natural like an excellent human tutor.
10. Do not make every answer unnecessarily long.
11. Explain difficult problems step by step.
12. Make beginner explanations simple.

{material_rule}

{web_rule}

LEARNING MODE:
{mode_rule}

STUDENT QUESTION:
{question}
"""


# ============================================================
# JSON CLEANER
# ============================================================

def clean_json(text: str) -> str:
    value = text.strip()

    if value.startswith("```"):
        value = re.sub(
            r"^```(?:json)?",
            "",
            value,
            flags=re.IGNORECASE,
        )

        value = re.sub(
            r"```$",
            "",
            value,
        )

    return value.strip()


# ============================================================
# WEB SOURCES
# ============================================================

def get_web_sources(response) -> list[dict]:
    sources: list[dict] = []

    try:
        metadata = response.candidates[0].grounding_metadata

        if not metadata:
            return []

        chunks = metadata.grounding_chunks or []

        for chunk in chunks:
            if chunk.web and chunk.web.uri:
                sources.append(
                    {
                        "title": chunk.web.title or "Web source",
                        "url": chunk.web.uri,
                    }
                )
    except Exception:
        return []

    unique: list[dict] = []
    seen: set[str] = set()

    for source in sources:
        if source["url"] not in seen:
            seen.add(source["url"])
            unique.append(source)

    return unique[:8]


# ============================================================
# AI GENERATION
# ============================================================

def generate_text(
    client: genai.Client,
    prompt: str,
    uploaded_file=None,
    use_web: bool = False,
):
    config = None

    if use_web:
        config = types.GenerateContentConfig(
            tools=[
                types.Tool(
                    google_search=types.GoogleSearch()
                )
            ]
        )

    last_error: Exception | None = None

    for model in get_models():
        try:
            if uploaded_file is not None:
                contents = [prompt, uploaded_file]
            else:
                contents = prompt

            response = client.models.generate_content(
                model=model,
                contents=contents,
                config=config,
            )

            answer = (response.text or "").strip()

            if not answer:
                raise RuntimeError(
                    f"{model} returned an empty answer."
                )

            return response, model

        except Exception as exc:
            last_error = exc

            if not is_retryable_error(exc):
                continue

    raise HTTPException(
        status_code=503,
        detail=(
            "All configured AI models are currently unavailable. "
            f"Last error: {last_error}"
        ),
    )


def generate_json(
    client: genai.Client,
    prompt: str,
    uploaded_file=None,
):
    last_error: Exception | None = None

    for model in get_models():
        try:
            if uploaded_file is not None:
                contents = [prompt, uploaded_file]
            else:
                contents = prompt

            response = client.models.generate_content(
                model=model,
                contents=contents,
            )

            text = clean_json(response.text or "")
            data = json.loads(text)

            return data, model

        except Exception as exc:
            last_error = exc

            if not is_retryable_error(exc):
                continue

    raise HTTPException(
        status_code=503,
        detail=f"Structured AI request failed: {last_error}",
    )


