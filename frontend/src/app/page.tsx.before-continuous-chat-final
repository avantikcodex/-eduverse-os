            </div>
          </div>

          <button
            onClick={generatePlan}
            disabled={planLoading}
            className="mt-5 w-full rounded-xl bg-gradient-to-r from-violet-400 to-cyan-300 px-5 py-3.5 font-black text-black"
          >
            {planLoading ? "Building your plan..." : "Build My Study Plan →"}
          </button>
        </Card>
      ) : (
        <>
          <Card>
            <div className="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <div className="text-xs uppercase tracking-[0.18em] text-cyan-300">
                  Personalized
                </div>
                <h2 className="mt-2 text-3xl font-black">{plan.title}</h2>
              </div>

              <div className="w-full max-w-xs">
                <div className="mb-2 flex justify-between text-xs text-zinc-700">
                  <span>Progress</span>
                  <span>{progress}%</span>
                </div>

                <div className="h-3 overflow-hidden rounded-full bg-white/10">
                  <div
                    className="h-full rounded-full bg-gradient-to-r from-violet-400 to-cyan-300 transition-all"
                    style={{ width: `${progress}%` }}
                  />
                </div>
              </div>
            </div>
          </Card>

          {plan.days.map((day: StudyDay) => (
            <Card key={day.day}>
              <div className="flex flex-col gap-4 sm:flex-row sm:justify-between">
                <div>
                  <div className="text-xs uppercase tracking-[0.2em] text-cyan-300">
                    Day {day.day}
                  </div>
                  <h3 className="mt-2 text-2xl font-black">{day.focus}</h3>
                </div>

                <div className="rounded-xl border border-white/10 px-3 py-2 text-xs text-zinc-600">
                  Learn + Practice
                </div>
              </div>

              <div className="mt-6 space-y-3">
                {day.tasks.map((task: string, index: number) => {
                  const key = `${day.day}-${index}`;

                  return (
                    <label
                      key={key}
                      className="flex cursor-pointer items-start gap-3 rounded-xl border border-white/10 bg-black/20 p-4 transition hover:bg-white/[0.03]"
                    >
                      <input
                        type="checkbox"
                        checked={!!completedTasks[key]}
                        onChange={() => toggleTask(key)}
