}: any) {
  const totalTasks =
    plan?.days?.reduce(
      (sum: number, day: StudyDay) => sum + day.tasks.length,
      0,
    ) || 0;

  const finished = Object.values(completedTasks).filter(Boolean).length;
  const progress = totalTasks
    ? Math.round((finished / totalTasks) * 100)
    : 0;

  return (
    <div className="space-y-7">
