"use client";

import {
  useEffect,
  useState,
  type ChangeEvent,
  type ReactNode,
} from "react";
import ReactMarkdown from "react-markdown";
import remarkGfm from "remark-gfm";
import remarkMath from "remark-math";
import rehypeKatex from "rehype-katex";

const API =
  process.env.NEXT_PUBLIC_API_URL || "http://127.0.0.1:8000";

type Role = "student" | "teacher";

type View =
  | "dashboard"
  | "subjects"
  | "tutor"
  | "quiz"
  | "plan"
  | "notices"
  | "materials"
  | "activity"
  | "profile"
  | "settings";

type User = {
  name: string;
  email: string;
  college: string;
  course: string;
  year: string;
};

type Material = {
  material_id: string;
  filename?: string;
  subject?: string;
  chapter?: string;
};

type QuizQuestion = {
  question: string;
  options: string[];
  answer: number;
  explanation?: string;
};

type QuizData = {
  title: string;
  questions: QuizQuestion[];
};

type StudyDay = {
  day: number;
  focus: string;
  tasks: string[];
  revision: string;
};

type StudyPlan = {
  title: string;
  days: StudyDay[];
};

type NoticeTask = {
  title?: string;
  date?: string;
  time?: string;
  location?: string;
  subject?: string;
  priority?: string;
};

const studentNav: { id: View; label: string; icon: string }[] = [
  { id: "dashboard", label: "Dashboard", icon: "⌂" },
  { id: "subjects", label: "My Subjects", icon: "▤" },
  { id: "tutor", label: "AI Tutor", icon: "✦" },
  { id: "quiz", label: "Quizzes", icon: "✓" },
  { id: "plan", label: "Study Plan", icon: "◫" },
  { id: "notices", label: "Notices", icon: "◉" },
];

const teacherNav: { id: View; label: string; icon: string }[] = [
  { id: "dashboard", label: "Dashboard", icon: "⌂" },
  { id: "subjects", label: "Subjects", icon: "▤" },
  { id: "materials", label: "Materials", icon: "□" },
  { id: "notices", label: "Smart Notices", icon: "◉" },
  { id: "activity", label: "Activity", icon: "◒" },
];

const subjects = [
  {
    name: "Java",
    chapters: 5,
    progress: 68,
    icon: "☕",
    desc: "OOP, inheritance, exceptions and collections.",
  },
  {
    name: "Python",
    chapters: 6,
    progress: 42,
    icon: "🐍",
    desc: "Programming fundamentals and problem solving.",
  },
  {
    name: "DBMS",
    chapters: 5,
    progress: 31,
    icon: "◈",
    desc: "SQL, normalization and transactions.",
  },
  {
    name: "Mathematics",
    chapters: 8,
    progress: 55,
    icon: "∑",
    desc: "Concepts, formulas and exam practice.",
  },
];

export default function Home() {
  const [booting, setBooting] = useState(true);
  const [loggedIn, setLoggedIn] = useState(false);

  const [role, setRole] = useState<Role>("student");
  const [view, setView] = useState<View>("dashboard");

  const [user, setUser] = useState<User>({
    name: "Avantik Dubey",
    email: "student@eduverse.demo",
    college: "ADYPU",
    course: "B.Tech CSE",
    year: "1st Year",
  });

  const [notificationsOpen, setNotificationsOpen] = useState(false);
  const [profileOpen, setProfileOpen] = useState(false);
  const [toast, setToast] = useState("");

  const [question, setQuestion] = useState("");
  const [mode, setMode] = useState("learn");
  const [answer, setAnswer] = useState("");
  const [answerLoading, setAnswerLoading] = useState(false);

  const [material, setMaterial] = useState<Material | null>(null);
  const [subject, setSubject] = useState("Java");
  const [chapter, setChapter] = useState("OOP & Inheritance");
  const [file, setFile] = useState<File | null>(null);
  const [uploadLoading, setUploadLoading] = useState(false);

  const [quizTopic, setQuizTopic] = useState("Java Inheritance");
  const [quiz, setQuiz] = useState<QuizData | null>(null);
  const [quizLoading, setQuizLoading] = useState(false);
  const [quizIndex, setQuizIndex] = useState(0);
  const [selectedOption, setSelectedOption] = useState<number | null>(null);
  const [quizSubmitted, setQuizSubmitted] = useState(false);
  const [quizFinished, setQuizFinished] = useState(false);
  const [quizScore, setQuizScore] = useState(0);

  const [planTopic, setPlanTopic] = useState("Java Exam Preparation");
  const [days, setDays] = useState(3);
  const [plan, setPlan] = useState<StudyPlan | null>(null);
  const [planLoading, setPlanLoading] = useState(false);
  const [completedTasks, setCompletedTasks] = useState<
    Record<string, boolean>
  >({});

  const [notice, setNotice] = useState("");
  const [noticeTasks, setNoticeTasks] = useState<NoticeTask[]>([]);
  const [taskLoading, setTaskLoading] = useState(false);

  useEffect(() => {
    const saved = localStorage.getItem("eduverse_session");

    if (saved) {
      try {
        const parsed = JSON.parse(saved);

        if (parsed?.user) setUser(parsed.user);
        if (parsed?.role) setRole(parsed.role);
        setLoggedIn(true);
      } catch {
        localStorage.removeItem("eduverse_session");
      }
    }

    setBooting(false);
  }, []);

  function showToast(text: string) {
    setToast(text);
    window.setTimeout(() => setToast(""), 2400);
  }

  function login(
    email: string,
    password: string,
    selectedRole: Role,
  ) {
    if (!email.trim() || !password.trim()) {
      showToast("Enter email and password.");
      return;
    }

    const loggedUser: User =
      selectedRole === "teacher"
        ? {
            name: "Demo Teacher",
            email,
            college: "ADYPU",
            course: "Faculty",
            year: "Academic Team",
          }
        : {
            name: "Avantik Dubey",
            email,
            college: "ADYPU",
            course: "B.Tech CSE",
            year: "1st Year",
          };

    setUser(loggedUser);
    setRole(selectedRole);
    setLoggedIn(true);
    setView("dashboard");

    localStorage.setItem(
      "eduverse_session",
      JSON.stringify({
        user: loggedUser,
        role: selectedRole,
      }),
    );

    showToast("Welcome to EduVerse OS.");
  }

  function logout() {
    localStorage.removeItem("eduverse_session");
    setLoggedIn(false);
    setProfileOpen(false);
    setNotificationsOpen(false);
    setView("dashboard");
  }

  function navigate(next: View) {
    setView(next);
    setProfileOpen(false);
    setNotificationsOpen(false);
  }

  async function askAI() {
    if (!question.trim()) {
      showToast("Type a question first.");
      return;
    }

    try {
      setAnswerLoading(true);
      setAnswer("");

      const body: any = {
        question,
        mode,
      };

      let tutorMaterialId: string | null = null;

      try {
        const savedTutorMaterial = localStorage.getItem(
          "eduverse_tutor_material"
        );

        if (savedTutorMaterial) {
          const parsed = JSON.parse(savedTutorMaterial);

          if (parsed?.material_id) {
            tutorMaterialId = parsed.material_id;
          }
        }
      } catch (error) {
        console.warn("Could not read Tutor PDF:", error);
      }

      const activeMaterialId =
        material?.material_id || tutorMaterialId;

      if (activeMaterialId) {
        body.material_id = activeMaterialId;
      }

      const response = await fetch(`${API}/ai/ask`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(body),
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.detail || "AI request failed.");
      }

      setAnswer(data.answer || "No answer received.");
    } catch (error: any) {
      setAnswer(
        `### AI request failed\n\n${error.message || "Unknown error"}`,
      );
    } finally {
      setAnswerLoading(false);
    }
  }

async function uploadMaterial(fileOverride?: File) {
  const selectedFile = fileOverride ?? file;

  if (!selectedFile) {
    showToast("Select a PDF first.");
    return;
  }

  try {
    setUploadLoading(true);

    const formData = new FormData();
    formData.append("file", selectedFile);
    formData.append("subject", subject);
    formData.append("chapter", chapter);

    const response = await fetch(`${API}/materials/upload`, {
      method: "POST",
      body: formData,
    });

    const data = await response.json();

    if (!response.ok) {
      throw new Error(data.detail || "Upload failed.");
    }

    setFile(selectedFile);
    setMaterial(data);

    showToast("✓ PDF uploaded and connected to AI Tutor.");
  } catch (error: any) {
    showToast(error.message || "Upload failed.");
  } finally {
    setUploadLoading(false);
  }
}

  async function generateQuiz() {
    try {
      setQuizLoading(true);

      const body: any = {
        topic: quizTopic,
      };

      if (material?.material_id) {
        body.material_id = material.material_id;
      }

      const response = await fetch(`${API}/quiz`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(body),
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.detail || "Quiz generation failed.");
      }

      setQuiz(data);
      setQuizIndex(0);
      setSelectedOption(null);
      setQuizSubmitted(false);
      setQuizFinished(false);
      setQuizScore(0);
      showToast("Quiz generated.");
    } catch (error: any) {
      showToast(error.message || "Quiz generation failed.");
    } finally {
      setQuizLoading(false);
    }
  }

  function submitAnswer() {
    if (!quiz || selectedOption === null) return;

    if (selectedOption === Number(quiz.questions[quizIndex].answer)) {
      setQuizScore((current) => current + 1);
    }

    setQuizSubmitted(true);
  }

  function nextQuestion() {
    if (!quiz) return;

    if (quizIndex >= quiz.questions.length - 1) {
      setQuizFinished(true);
      return;
    }

    setQuizIndex((current) => current + 1);
    setSelectedOption(null);
    setQuizSubmitted(false);
  }

  function restartQuiz() {
    setQuizIndex(0);
    setSelectedOption(null);
    setQuizSubmitted(false);
    setQuizFinished(false);
    setQuizScore(0);
  }

  async function generatePlan() {
    try {
      setPlanLoading(true);

      const response = await fetch(`${API}/study-plan`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          goal: planTopic,
          days,
        }),
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.detail || "Study plan failed.");
      }

      setPlan(data);
      setCompletedTasks({});
      showToast("Study plan created.");
    } catch (error: any) {
      showToast(error.message || "Study plan failed.");
    } finally {
      setPlanLoading(false);
    }
  }

  function toggleTask(key: string) {
    setCompletedTasks((current) => ({
      ...current,
      [key]: !current[key],
    }));
  }

  async function extractTasks() {
    if (!notice.trim()) {
      showToast("Paste a notice first.");
      return;
    }

    try {
      setTaskLoading(true);

      const response = await fetch(`${API}/tasks/extract`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          notice,
        }),
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.detail || "Task extraction failed.");
      }

      const extracted = Array.isArray(data)
        ? data
        : Array.isArray(data.tasks)
          ? data.tasks
          : data.task
            ? [data.task]
            : [data];

      setNoticeTasks(extracted);
      showToast("Notice converted into tasks.");
    } catch (error: any) {
      showToast(error.message || "Task extraction failed.");
    } finally {
      setTaskLoading(false);
    }
  }

  function saveProfile() {
    const existing = localStorage.getItem("eduverse_session");

    if (existing) {
      try {
        const parsed = JSON.parse(existing);
        localStorage.setItem(
          "eduverse_session",
          JSON.stringify({
            ...parsed,
            user,
          }),
        );
      } catch {
        // ignore
      }
    }

    showToast("Profile saved.");
  }

  const nav = role === "student" ? studentNav : teacherNav;

  if (booting) {
    return (
      <div className="flex min-h-screen items-center justify-center bg-[#050609] text-white">
        <div className="text-center">
          <div className="mx-auto mb-5 flex h-16 w-16 animate-pulse items-center justify-center rounded-3xl bg-gradient-to-br from-cyan-300 to-violet-500 text-2xl font-black text-black">
            E
          </div>
          <div className="font-bold">Loading EduVerse OS</div>
          <div className="mt-2 text-sm text-zinc-600">
            Initializing your learning workspace...
          </div>
        </div>
      </div>
    );
  }

  if (!loggedIn) {
    return (
      <LoginScreen
        onLogin={login}
        role={role}
        setRole={setRole}
      />
    );
  }

  return (
    <div className="min-h-screen bg-[#050609] text-white">
      <div className="pointer-events-none fixed inset-0 overflow-hidden">
        <div className="absolute -left-40 -top-40 h-96 w-96 rounded-full bg-cyan-500/10 blur-[100px]" />
        <div className="absolute -right-40 top-20 h-96 w-96 rounded-full bg-violet-500/10 blur-[100px]" />
      </div>

      <header className="sticky top-0 z-50 border-b border-white/10 bg-[#050609]/80 backdrop-blur-2xl">
        <div className="mx-auto flex max-w-[1500px] items-center justify-between px-5 py-3">
          <div className="flex items-center gap-3">
            <button
              onClick={() => navigate("dashboard")}
              className="group flex items-center gap-3"
            >
              <div className="relative flex h-10 w-10 items-center justify-center overflow-hidden rounded-2xl bg-gradient-to-br from-cyan-300 to-violet-500 font-black text-black shadow-lg shadow-cyan-500/10">
                E
                <div className="absolute inset-0 translate-y-full bg-white/30 transition group-hover:translate-y-0" />
              </div>

              <div className="hidden text-left sm:block">
                <div className="font-bold">EduVerse OS</div>
                <div className="text-[10px] uppercase tracking-[0.2em] text-zinc-600">
                  AI Learning Brain
                </div>
              </div>
            </button>

            <div className="hidden h-7 w-px bg-white/10 sm:block" />

            <div className="hidden rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 text-xs text-zinc-500 md:block">
              {role === "student" ? "Student Workspace" : "Teacher Workspace"}
            </div>
          </div>

          <div className="flex items-center gap-2">
            <button
              onClick={() =>
                setNotificationsOpen((current) => !current)
              }
              className="relative flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/[0.03] text-zinc-400 transition hover:bg-white/[0.07] hover:text-white"
            >
              ◉
              <span className="absolute right-2 top-2 h-1.5 w-1.5 rounded-full bg-cyan-300" />
            </button>

            <div className="relative">
              <button
                onClick={() => setProfileOpen((current) => !current)}
                className="flex items-center gap-3 rounded-xl border border-white/10 bg-white/[0.03] px-2.5 py-2 transition hover:bg-white/[0.07]"
              >
                <div className="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-white to-zinc-400 text-sm font-black text-black">
                  {user.name.charAt(0)}
                </div>

                <div className="hidden text-left lg:block">
                  <div className="text-sm font-semibold">{user.name}</div>
                  <div className="text-[11px] text-zinc-600">{role}</div>
                </div>

                <span className="text-xs text-zinc-500">⌄</span>
              </button>

              {profileOpen && (
                <ProfileMenu
                  user={user}
                  role={role}
                  onProfile={() => navigate("profile")}
                  onSettings={() => navigate("settings")}
                  onNotifications={() => navigate("notices")}
                  onLogout={logout}
                />
              )}
            </div>
          </div>
        </div>
      </header>

      {notificationsOpen && (
        <div className="fixed right-5 top-[72px] z-40 w-[330px] rounded-2xl border border-white/10 bg-[#0b0c11]/95 p-4 shadow-2xl backdrop-blur-xl">
          <div className="mb-4 flex items-center justify-between">
            <div className="font-semibold">Notifications</div>
            <span className="rounded-full bg-cyan-400/10 px-2 py-1 text-[10px] text-cyan-300">
              3 new
            </span>
          </div>

          <NotificationItem
            icon="📚"
            title="New material uploaded"
            text="Java → Inheritance is ready."
          />
          <NotificationItem
            icon="📝"
            title="Quiz generated"
            text="Your Java practice quiz is ready."
          />
          <NotificationItem
            icon="🔥"
            title="Study streak"
            text="You are on a 7 day streak."
          />
        </div>
      )}

      <div className="relative mx-auto grid min-h-[calc(100vh-65px)] max-w-[1500px] lg:grid-cols-[240px_1fr]">
        <aside className="hidden border-r border-white/10 p-4 lg:block">
          <div className="sticky top-24">
            <div className="mb-5 px-3 text-[10px] uppercase tracking-[0.22em] text-zinc-700">
              Main Menu
            </div>

            <div className="space-y-1">
              {nav.map((item) => (
                <NavItem
                  key={item.id}
                  active={view === item.id}
                  icon={item.icon}
                  label={item.label}
                  onClick={() => navigate(item.id)}
                />
              ))}
            </div>

            <div className="my-5 h-px bg-white/10" />

            <div className="mb-2 px-3 text-[10px] uppercase tracking-[0.22em] text-zinc-700">
              Account
            </div>

            <NavItem
              active={view === "profile"}
              icon="◉"
              label="Profile"
              onClick={() => navigate("profile")}
            />

            <NavItem
              active={view === "settings"}
              icon="⚙"
              label="Settings"
              onClick={() => navigate("settings")}
            />

            <button
              onClick={logout}
              className="mt-1 flex w-full items-center gap-3 rounded-xl px-3 py-3 text-left text-sm text-zinc-600 transition hover:bg-red-400/5 hover:text-red-300"
            >
              <span>↪</span>
              <span>Logout</span>
            </button>

            <div className="mt-8 rounded-2xl border border-cyan-400/10 bg-gradient-to-br from-cyan-400/[0.06] to-violet-400/[0.06] p-4">
              <div className="mb-2 flex items-center gap-2">
                <span className="h-2 w-2 rounded-full bg-emerald-400" />
                <span className="text-xs font-semibold text-emerald-300">
                  AI Systems Online
                </span>
              </div>

              <p className="text-xs leading-5 text-zinc-600">
                Tutor, quiz generation and study planning are ready.
              </p>
            </div>
          </div>
        </aside>

        <main className="min-w-0 p-5 sm:p-8">
          <div className="mx-auto max-w-6xl">
            <div className="mb-6 flex items-center gap-2 overflow-x-auto lg:hidden">
              {nav.map((item) => (
                <button
                  key={item.id}
                  onClick={() => navigate(item.id)}
                  className={`whitespace-nowrap rounded-xl border px-3 py-2 text-xs ${
                    view === item.id
                      ? "border-white bg-white text-black"
                      : "border-white/10 text-zinc-500"
                  }`}
                >
                  {item.icon} {item.label}
                </button>
              ))}
            </div>

            {view === "dashboard" && (
              <DashboardView
                role={role}
                user={user}
                navigate={navigate}
                stats={
                  role === "student"
                    ? [
                        ["Subjects", "06"],
                        ["Materials", material ? "13" : "12"],
                        ["AI Questions", "24"],
                        ["Streak", "07d"],
                      ]
                    : [
                        ["Subjects", "06"],
                        ["Materials", "42"],
                        ["Students", "128"],
                        ["AI Usage", "89%"],
                      ]
                }
                question={question}
                setQuestion={setQuestion}
                askAI={askAI}
                answerLoading={answerLoading}
              />
            )}

            {view === "subjects" && (
              <SubjectsView
                role={role}
                navigate={navigate}
                material={material}
              />
            )}

            {view === "tutor" && (
              <TutorView
                question={question}
                setQuestion={setQuestion}
                mode={mode}
                setMode={setMode}
                askAI={askAI}
                answerLoading={answerLoading}
                answer={answer}
                material={material}
                copy={() => {
                  navigator.clipboard.writeText(answer);
                  showToast("Answer copied.");
                }}
              />
            )}

            {view === "quiz" && (
              <QuizView
                quizTopic={quizTopic}
                setQuizTopic={setQuizTopic}
                generateQuiz={generateQuiz}
                quizLoading={quizLoading}
                quiz={quiz}
                quizIndex={quizIndex}
                selectedOption={selectedOption}
                setSelectedOption={setSelectedOption}
                quizSubmitted={quizSubmitted}
                submitAnswer={submitAnswer}
                nextQuestion={nextQuestion}
                quizFinished={quizFinished}
                quizScore={quizScore}
                restartQuiz={restartQuiz}
                material={material}
              />
            )}

            {view === "plan" && (
              <PlanView
                planTopic={planTopic}
                setPlanTopic={setPlanTopic}
                days={days}
                setDays={setDays}
                plan={plan}
                planLoading={planLoading}
                generatePlan={generatePlan}
                completedTasks={completedTasks}
                toggleTask={toggleTask}
              />
            )}

            {view === "materials" && (
              <MaterialsView
                subject={subject}
                setSubject={setSubject}
                chapter={chapter}
                setChapter={setChapter}
                file={file}
                setFile={setFile}
                material={material}
                uploadMaterial={uploadMaterial}
                uploadLoading={uploadLoading}
              />
            )}

            {view === "notices" && (
              <NoticesView
                role={role}
                notice={notice}
                setNotice={setNotice}
                noticeTasks={noticeTasks}
                taskLoading={taskLoading}
                extractTasks={extractTasks}
              />
            )}

            {view === "activity" && <ActivityView />}

            {view === "profile" && (
              <ProfileView
                user={user}
                setUser={setUser}
                saveProfile={saveProfile}
                role={role}
              />
            )}

            {view === "settings" && <SettingsView showToast={showToast} />}
          </div>
        </main>
      </div>

      {toast && (
        <div className="fixed bottom-6 left-1/2 z-[100] -translate-x-1/2 rounded-2xl border border-white/10 bg-[#111218]/95 px-5 py-3 text-sm shadow-2xl backdrop-blur-xl">
          {toast}
        </div>
      )}
    </div>
  );
}

function LoginScreen({
  onLogin,
  role,
  setRole,
}: {
  onLogin: (email: string, password: string, role: Role) => void;
  role: Role;
  setRole: (role: Role) => void;
}) {
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");

  return (
    <main className="relative flex min-h-screen overflow-hidden bg-[#050609] text-white">
      <div className="pointer-events-none absolute inset-0">
        <div className="absolute -left-32 top-[-10%] h-[500px] w-[500px] rounded-full bg-cyan-500/15 blur-[130px]" />
        <div className="absolute -right-32 bottom-[-10%] h-[500px] w-[500px] rounded-full bg-violet-500/15 blur-[130px]" />

        <div
          className="absolute inset-0 opacity-[0.07]"
