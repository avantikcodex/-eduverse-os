              <div className="mt-3 text-sm text-zinc-400">
                Correct answer:{" "}
                <span className="font-semibold text-white">
                  {current.options[Number(current.answer) - 1]}
                </span>
              </div>

              {current.explanation && (
                <div className="mt-4 border-t border-white/10 pt-4">
                  <div className="text-xs uppercase tracking-[0.16em] text-cyan-300">
                    Explanation
                  </div>

                  <p className="mt-2 text-sm leading-7 text-zinc-500">
                    {current.explanation}
                  </p>
                </div>
              )}
            </div>
          )}

          <div className="mt-5 flex justify-end">
            {!quizSubmitted ? (
              <button
                onClick={submitAnswer}
                disabled={selectedOption === null}
                className="rounded-xl bg-gradient-to-r from-cyan-300 to-violet-400 px-6 py-3 font-black text-black disabled:opacity-40"
              >
                Submit Answer
              </button>
            ) : (
              <button
                onClick={nextQuestion}
                className="rounded-xl bg-white px-6 py-3 font-black text-black"
              >
                {quizIndex === quiz.questions.length - 1
                  ? "View Result"
                  : "Next Question →"}
              </button>
            )}
          </div>
        </Card>
      )}

      {quizFinished && quiz && (
        <Card>
          <div className="mx-auto max-w-xl py-10 text-center">
            <div className="text-6xl">✦</div>
            <div className="mt-4 text-xs uppercase tracking-[0.25em] text-cyan-300">
              Quiz Complete
            </div>
            <h2 className="mt-3 text-6xl font-black">
              {quizScore}/{quiz.questions.length}
            </h2>
            <div className="mt-2 text-zinc-600">
              {Math.round((quizScore / quiz.questions.length) * 100)}% score
            </div>

            <div className="mt-7 flex justify-center gap-3">
              <button
                onClick={restartQuiz}
                className="rounded-xl border border-white/10 px-5 py-3 font-semibold"
              >
                Try Again
              </button>

              <button
                onClick={generateQuiz}
                className="rounded-xl bg-white px-5 py-3 font-black text-black"
              >
                New Quiz
              </button>
            </div>
          </div>
        </Card>
      )}
    </div>
  );
}

function PlanView({
